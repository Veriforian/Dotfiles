#!/bin/bash
# theme-set hook (runs after Omarchy's own terminal sync). Omarchy pushes the
# theme's plain background into running foot terminals and tmux (OSC 11 +
# window-style). Push the darker one from ~/.config/omarchy/themed/foot.ini.tpl
# instead, so open terminals match new ones. Docs: chezmoi repo docs/desktop.md.

foot_ini="$HOME/.local/state/omarchy/current/theme/foot.ini"
bg=$(sed -n 's/^background=\([0-9A-Fa-f]\{6\}\)$/\1/p' "$foot_ini" 2>/dev/null | head -1)
fg=$(sed -n 's/^foreground=\([0-9A-Fa-f]\{6\}\)$/\1/p' "$foot_ini" 2>/dev/null | head -1)
[[ -n $bg ]] || exit 0

# OSC 11 = default background, OSC 4;0 = ANSI black (Omarchy ties it to the background).
osc="\033]11;#$bg\007\033]4;0;#$bg\007"

push_to_tty() {
  [[ $1 == /dev/pts/* ]] && printf '%b' "$osc" >"$1" 2>/dev/null
}

# Running foot windows (same discovery as omarchy-theme-set-foot).
for foot_pid in $(pgrep -x foot); do
  for child_pid in $(pgrep -P "$foot_pid"); do
    push_to_tty "$(readlink "/proc/$child_pid/fd/1" 2>/dev/null)"
  done
done

# tmux: pane style plus every pane's colours (same as omarchy-theme-set-tmux).
if tmux list-sessions &>/dev/null; then
  style="bg=#$bg"
  [[ -n $fg ]] && style="fg=#$fg,$style"
  tmux set-option -g window-style "$style" 2>/dev/null
  tmux set-option -g window-active-style "$style" 2>/dev/null
  while IFS= read -r pane_tty; do
    push_to_tty "$pane_tty"
  done < <(tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | sort -u)
fi

exit 0
