{{- $email := promptStringOnce . "email" "Git email for this machine" -}}
{{- $work  := promptBoolOnce   . "work"  "Is this a work machine" -}}
[data]
  email = {{ $email | quote }}
  work  = {{ $work }}
  vm    = {{ stat "/usr/share/try-omarchy" | not | not }}
[diff]
  pager = "delta"
[edit]
  command = "nvim"
  apply = true
[merge]
  command = "nvim"
  args = ["-d"]
