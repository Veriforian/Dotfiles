#!/bin/bash
# pgAdmin 4 in Docker (dpage/pgadmin4 has an arm64 build; the AUR packages are
# x86-only repackages). Desktop mode: no pgAdmin login, no master password.
# Host networking on 127.0.0.1:5050, so it reaches postgres18 on
# 127.0.0.1:5432 and the work VPN's databases like any VM program (with Mullvad
# on, only the VM's own traffic may use the work tunnel). Data: volume
# pgadmin-data. Launcher: pgAdmin.desktop (app launcher). Docs: docs/tools.md#pgadmin
#
# Usage: pgadmin                       open it as a web app (starting it if needed)
#        pgadmin ensure                create/start it without opening (setup scripts)
#        pgadmin import <servers.json> add servers exported from another pgAdmin
#                                      (Tools > Import/Export Servers > Export)
#        pgadmin stop
set -euo pipefail

name=pgadmin
image=dpage/pgadmin4:latest
volume=pgadmin-data
url=http://127.0.0.1:5050

die() { echo "pgadmin: $*" >&2; command -v notify-send >/dev/null && notify-send "pgAdmin" "$*"; exit 1; }
# Omarchy keeps users out of the root-equivalent docker group unless they opt
# in, so elevate when needed: sudo in a terminal, a polkit prompt otherwise
# (e.g. started from the app launcher).
needs_sudo() {
  if command -v omarchy-sudo-docker >/dev/null; then omarchy-sudo-docker; else [ ! -w /var/run/docker.sock ]; fi
}
dock() {
  if ! needs_sudo; then docker "$@"
  elif [ -t 0 ]; then sudo docker "$@"
  else pkexec docker "$@"; fi
}
up() { curl -fs -o /dev/null --max-time 2 "$url/misc/ping"; }
load_servers() { # $1 = JSON file on the VM
  # Stream it in (written by the container's pgadmin user): docker cp would keep
  # the file's owner and mode, and pgAdmin can't read a private (600) file.
  dock exec -i "$name" sh -c 'cat >/tmp/servers.json' <"$1"
  dock exec "$name" /venv/bin/python3 /pgadmin4/setup.py load-servers /tmp/servers.json 2>&1 |
    grep -v -E 'SyntaxWarning|return \(ssh_host'
}

ensure_running() {
  up && return 0
  local fresh=0
  if ! dock container inspect "$name" >/dev/null 2>&1; then
    echo "pgadmin: creating the $name container ($image)"
    dock run -d --restart unless-stopped --name "$name" --network host \
      -e PGADMIN_CONFIG_SERVER_MODE=False \
      -e PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False \
      -e PGADMIN_LISTEN_ADDRESS=127.0.0.1 -e PGADMIN_LISTEN_PORT=5050 \
      -e PGADMIN_DEFAULT_EMAIL=pgadmin@localhost.dev -e PGADMIN_DEFAULT_PASSWORD=unused-in-desktop-mode \
      -v "$volume:/var/lib/pgadmin" "$image" >/dev/null
    fresh=1
  else
    dock start "$name" >/dev/null
  fi
  for _ in $(seq 90); do up && break; sleep 1; done
  up || die "pgAdmin didn't start (docker logs $name)"
  if [ "$fresh" = 1 ]; then
    # First start: add the local Docker PostgreSQL (pg-local: trust auth, no password).
    local tmp
    tmp=$(mktemp --suffix=.json)
    cat >"$tmp" <<JSON
{"Servers": {"1": {"Name": "Local (postgres18)", "Group": "Local", "Host": "127.0.0.1", "Port": 5432,
  "MaintenanceDB": "postgres", "Username": "$USER", "SSLMode": "prefer"}}}
JSON
    load_servers "$tmp" | grep -E "Added|rror" || true
    rm -f "$tmp"
  fi
}

case ${1:-open} in
  open)
    ensure_running
    echo "pgadmin: $url"
    [ -n "${PGADMIN_NO_OPEN:-}" ] || omarchy-launch-webapp "$url" >/dev/null 2>&1 &
    ;;
  ensure)
    ensure_running
    echo "pgadmin: ready on $url"
    ;;
  import)
    [ -f "${2:-}" ] || die "usage: pgadmin import <servers.json>"
    ensure_running
    load_servers "$2"
    echo "pgadmin: imported. Passwords aren't part of the export; pgAdmin asks on first connect (tick 'Save password')."
    ;;
  stop)
    dock stop "$name" >/dev/null && echo "pgadmin: stopped"
    ;;
  *)
    die "usage: pgadmin [open|ensure|import <servers.json>|stop]"
    ;;
esac
