#!/bin/bash
# Local Redis in Docker, Omarchy's way (omarchy-install-docker-dbs: container
# redis, redis:7, 127.0.0.1:6379, no password) plus [::1]:6379 and a named
# volume, so data survives re-creating the container. Restarts with Docker
# (docker.service is enabled at boot by run_onchange_after_70-dev-services).
# Docs: docs/tools.md#redis
#
# Usage: redis-local [ensure]   create/start it and wait until it answers PING
#        redis-local stop
# Env:   REDIS_CONTAINER=redis REDIS_IMAGE=redis:7 REDIS_VOLUME=redis-data REDIS_PORT=6379
set -euo pipefail

name=${REDIS_CONTAINER:-redis}
image=${REDIS_IMAGE:-redis:7}
volume=${REDIS_VOLUME:-redis-data}
port=${REDIS_PORT:-6379}

die() { echo "redis-local: $*" >&2; exit 1; }
# Omarchy keeps users out of the root-equivalent docker group unless they opt
# in, so elevate when needed: sudo in a terminal, a polkit prompt otherwise.
needs_sudo() {
  if command -v omarchy-sudo-docker >/dev/null; then omarchy-sudo-docker; else [ ! -w /var/run/docker.sock ]; fi
}
dock() {
  if ! needs_sudo; then docker "$@"
  elif [ -t 0 ]; then sudo docker "$@"
  else pkexec docker "$@"; fi
}
# Over the published port, like the services connect (not docker exec).
ping() { exec 3<>"/dev/tcp/127.0.0.1/$port" && printf 'PING\r\n' >&3 && timeout 2 head -c5 <&3 | grep -q PONG; } 2>/dev/null

case ${1:-ensure} in
  ensure)
    # Publish on 127.0.0.1 AND ::1: "localhost" resolves to ::1 first (Node
    # connects there), and Docker only listens where it's told. Containers from
    # before this lack ::1 and are re-created; the data is in the volume.
    if dock container inspect "$name" >/dev/null 2>&1 &&
      ! dock inspect -f '{{json .HostConfig.PortBindings}}' "$name" | grep -q '"HostIp":"::1"'; then
      echo "redis-local: re-creating $name to also listen on [::1]:$port (data stays in $volume)"
      dock stop "$name" >/dev/null  # clean shutdown (Redis saves to disk)
      dock rm "$name" >/dev/null
    fi
    if dock container inspect "$name" >/dev/null 2>&1; then
      dock start "$name" >/dev/null
    else
      echo "redis-local: creating $name ($image, localhost:$port, volume $volume)"
      dock run -d --restart unless-stopped -p "127.0.0.1:$port:6379" -p "[::1]:$port:6379" --name "$name" \
        -v "$volume:/data" "$image" >/dev/null
    fi
    for _ in $(seq 60); do (ping) && break; sleep 1; done
    (ping) || die "$name didn't answer on 127.0.0.1:$port (docker logs $name)"
    echo "redis-local: $name ready on 127.0.0.1:$port"
    ;;
  stop)
    dock stop "$name" >/dev/null && echo "redis-local: stopped $name"
    ;;
  *)
    die "usage: redis-local [ensure|stop]"
    ;;
esac
