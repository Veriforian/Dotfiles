# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default Omarchy aliases and functions
# (don't mess with these directly, just overwrite them here!)
source "$OMARCHY_PATH/default/bash/rc"

# Add your own exports, aliases, and functions here.
#
# Make an alias for invoking commands you use constantly
# alias p='python'

# Add go to path
export PATH=$PATH:$(go env GOPATH)/bin
export GOPRIVATE="gitlab.com/trazi-ventures/*,github.com/TetonDigitalLLC/*"

# CUDA
export CUDA_HOME=/opt/cuda
export PATH=/opt/cuda/bin:$PATH
export LD_LIBRARY_PATH=/opt/cuda/lib64:/usr/lib:/usr/local/lib:$LD_LIBRARY_PATH

alias ws="cd ~/Documents/Workspace/Professional"
alias fixVesk="systemctl --user restart xdg-desktop-portal xdg-desktop-portal-hyprland pipewire wireplumber"

# SSH agent: one per login (systemd ssh-agent.socket), shared by every terminal,
# tmux pane, nvim and lazygit. Keep an existing socket (e.g. ssh -A forwarding).
export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-$XDG_RUNTIME_DIR/ssh-agent.socket}"
# Ask for the key passphrase once, in the first terminal after login. ssh-add -l
# exits 1 when the agent runs but holds no keys (2 = no agent: skip). Ctrl+C
# skips; AddKeysToAgent in ~/.ssh/config then asks on first git use instead.
if [[ -f ~/.ssh/id_ed25519 ]]; then
  ssh-add -l &>/dev/null
  [[ $? -eq 1 ]] && ssh-add ~/.ssh/id_ed25519
fi

# PostgreSQL runs in Docker (container postgres18, 127.0.0.1:5432; docs/tools.md#postgresql),
# so there's no local socket: point psql/pg_dump/createdb at it over TCP (IPv4:
# Docker publishes on 127.0.0.1 only, so "localhost" would try ::1 first).
export PGHOST="${PGHOST:-127.0.0.1}"

# Machine-local secrets and overrides (untracked; see .chezmoiignore)
[[ -f ~/.bashrc.local ]] && source ~/.bashrc.local
